---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillsCarousel from '../components/SkillsCarousel';
import HeroSection from '../components/HeroSection';
import AboutSection from '../components/AboutSection';
import ProjectsSection from '../components/ProjectsSection';
import ResumeSection from '../components/ResumeSection';
import ContactForm from '../components/ContactForm';

const projects = [
  {
    title: 'RhinoMCP – AI-driven geometry generation in Rhino 3D',
    description: 'Built an MCP integration enabling users to generate parametric buildings and bridges using natural language.',
    videoUrl: 'https://youtu.be/xDlB3Oj2Fg8',
    githubUrl: 'https://github.com/Ryan19941212/rhinomcp',
    bullets: [
      { icon: '🚀', bold: 'Reduced manual modeling time by 80%', text: '– Automated complex parametric workflows' },
      { icon: '🤖', bold: 'Combined LLM reasoning with 3D procedural design', text: '– Seamlessly bridged natural language and computational geometry' },
      { icon: '🧩', bold: 'Integrated with Python and Rhino API', text: '– Built robust, production-ready tooling for architects' },
    ],
  },
  {
    title: 'F1Tenth Autonomous Racing',
    description: 'Implemented 6 autonomous driving algorithms from scratch — reactive control → PID → path tracking → sampling-based planning → MPC — on a real 1/10-scale race car running ROS 2 on NVIDIA Jetson.',
    videoUrl: 'https://youtu.be/QS4dnrDDZss',
    githubUrl: 'https://github.com/Ryan19941212/F1tenth',
    bullets: [
      { icon: '🏎️', bold: '6 algorithms implemented from scratch', text: '– AEB → PID Wall Follow → Follow the Gap → Pure Pursuit → RRT* → MPC' },
      { icon: '🤖', bold: 'Deployed on NVIDIA Jetson Orin Nano', text: '– ROS 2 Humble with real RPLiDAR A2M12 and VESC motor controller' },
      { icon: '🛡️', bold: 'Safety-first architecture', text: '– Priority-based Ackermann mux with AEB override at highest priority (200)' },
    ],
  },
];
---

<BaseLayout
  title="Ryan Huang | AI Product Manager | UCLA Anderson MBA"
  description="AI Product Manager building data-driven, human-centered products. UCLA Anderson MBA with civil engineering and automation background. Specializing in AI-powered tools for construction and design."
>
  <!-- Hero Section with Parallax and Mouse Tracking -->
  <HeroSection client:load />

  <!-- About Section with Animated Gradient Border -->
  <AboutSection client:load />

  <!-- Skills Section -->
  <SkillsCarousel client:only="react" />

  <!-- Projects Section with Animated Hover Effects -->
  <ProjectsSection projects={projects} client:load />

  <!-- Resume Section with Glowing Hover Effects -->
  <ResumeSection baseUrl={import.meta.env.BASE_URL} client:load />

  <!-- Contact Section -->
  <ContactForm client:load />
</BaseLayout>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .animate-fade-in {
    opacity: 0;
    animation: fadeIn 1s ease-in forwards;
  }

  .animate-fade-in-up {
    opacity: 0;
    animation: fadeIn 1s ease-in forwards;
  }

  @keyframes gradient {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  .animate-gradient {
    background-size: 200% 200%;
    animation: gradient 15s ease infinite;
  }

  /* Smooth scrolling */
  html {
    scroll-behavior: smooth;
  }

  /* Gradient underline animation */
  .gradient-underline {
    position: relative;
    display: inline-block;
  }

  .gradient-underline::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, #60a5fa, #a78bfa, #f472b6);
    background-size: 200% 100%;
    animation: gradientShift 3s ease infinite;
  }

  @keyframes gradientShift {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }
</style>
