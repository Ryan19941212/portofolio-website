---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection';
import F1TenthShowcase from '../components/F1TenthShowcase';
import ProjectsSection from '../components/ProjectsSection';
import TechStack from '../components/SkillsCarousel';
import AboutSection from '../components/AboutSection';
import ResumeSection from '../components/ResumeSection';
import ContactForm from '../components/ContactForm';

const projects = [
  {
    id: 'rhinomcp',
    title: 'RhinoMCP',
    subtitle: 'AI-driven parametric geometry in Rhino 3D',
    description:
      'Built an MCP integration that lets architects generate parametric buildings and bridges from natural-language prompts, bridging LLM reasoning with Rhino\'s Python API.',
    videoUrl: 'https://youtu.be/xDlB3Oj2Fg8',
    githubUrl: 'https://github.com/Ryan19941212/rhinomcp',
    tags: ['MCP', 'LLM Agent', 'Python', 'Rhino API', 'Procedural Geometry'],
    metrics: [
      { label: 'TIME_SAVED',   value: '80%' },
      { label: 'STACK',        value: 'MCP + PY' },
      { label: 'STATUS',       value: 'Shipped' },
    ],
  },
];
---

<BaseLayout
  title="Ryan Huang · Robotics Product Manager who ships code"
  description="Robotics Product Manager and autonomy engineer. UCLA Anderson MBA + 5 years of engineering. Building end-to-end autonomous systems on ROS 2 and NVIDIA Jetson."
>
  <HeroSection client:load />
  <F1TenthShowcase client:load />
  <ProjectsSection projects={projects} client:load />
  <TechStack client:only="react" />
  <AboutSection client:load />
  <ResumeSection baseUrl={import.meta.env.BASE_URL} client:load />
  <ContactForm client:load />
</BaseLayout>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>
