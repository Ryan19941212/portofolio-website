---
const navItems = [
  { name: 'F1TENTH',  href: '#f1tenth',  index: '01' },
  { name: 'WORK',     href: '#projects', index: '02' },
  { name: 'STACK',    href: '#stack',    index: '03' },
  { name: 'ABOUT',    href: '#about',    index: '04' },
  { name: 'RESUME',   href: '#resume',   index: '05' },
  { name: 'CONTACT',  href: '#contact',  index: '06' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-ink-950/70 backdrop-blur-md border-b border-white/5">
  <nav class="max-w-[1400px] mx-auto px-6 lg:px-10">
    <div class="flex items-center justify-between h-16">
      <!-- Logo / ID block -->
      <a href="#home" class="group flex items-center gap-3">
        <div class="flex items-center gap-2">
          <div class="w-2 h-2 bg-nv-500 rounded-full group-hover:animate-pulse" />
          <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-300">
            RYAN_HUANG
          </span>
        </div>
        <span class="hidden sm:inline-block font-mono text-[10px] text-ink-500 border-l border-white/10 pl-3">
          v2.0 / 2026
        </span>
      </a>

      <!-- Desktop nav -->
      <div class="hidden md:flex items-center gap-1">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="group relative px-4 py-2 text-ink-300 hover:text-white transition-colors duration-200"
          >
            <span class="font-mono text-[10px] text-ink-500 mr-1.5 group-hover:text-nv-500 transition-colors">
              {item.index}
            </span>
            <span class="font-mono text-[11px] tracking-[0.15em] font-medium">
              {item.name}
            </span>
            <span class="absolute left-4 right-4 bottom-1 h-px bg-nv-500 scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300" />
          </a>
        ))}
      </div>

      <!-- Status indicator (desktop) -->
      <div class="hidden lg:flex items-center gap-2 border border-white/10 rounded px-3 py-1.5">
        <span class="live-dot" />
        <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-ink-300">
          Open to work
        </span>
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-button"
        type="button"
        class="md:hidden inline-flex items-center justify-center p-2 text-ink-300 hover:text-white border border-white/10 rounded"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span class="sr-only">Open menu</span>
        <svg class="block h-5 w-5 menu-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="hidden h-5 w-5 close-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div class="md:hidden hidden" id="mobile-menu">
      <div class="py-4 space-y-1 border-t border-white/5">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="block px-4 py-3 text-ink-300 hover:text-white hover:bg-white/5 mobile-nav-link transition-colors"
          >
            <span class="font-mono text-[10px] text-ink-500 mr-3">{item.index}</span>
            <span class="font-mono text-xs tracking-[0.15em]">{item.name}</span>
          </a>
        ))}
      </div>
    </div>
  </nav>
</header>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = mobileMenuButton?.querySelector('.menu-icon');
  const closeIcon = mobileMenuButton?.querySelector('.close-icon');
  const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

  const toggleMenu = (open?: boolean) => {
    const shouldOpen = open ?? mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden', !shouldOpen);
    mobileMenuButton?.setAttribute('aria-expanded', String(!!shouldOpen));
    menuIcon?.classList.toggle('hidden', !!shouldOpen);
    menuIcon?.classList.toggle('block', !shouldOpen);
    closeIcon?.classList.toggle('hidden', !shouldOpen);
    closeIcon?.classList.toggle('block', !!shouldOpen);
  };

  mobileMenuButton?.addEventListener('click', () => toggleMenu());
  mobileNavLinks.forEach(link => link.addEventListener('click', () => toggleMenu(false)));
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (!mobileMenuButton?.contains(t) && !mobileMenu?.contains(t)) toggleMenu(false);
  });
</script>
